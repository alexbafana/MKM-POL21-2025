<?xml version="1.0" encoding="UTF-8"?>
<!-- PROVISIONAL FIRST DRAFT. Candidate assignments require Sowelu Avanzo's review. -->
<DAOMod_DO_diagram xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="DAOMod_XSD_Decentralized_Organization.xsd"
  name="Currynomics DAO-ML first draft" uniqueID="CurrynomicsDAO-ML">
  <DAO DAO_ID="CurrynomicsDAO" DAO_name="Currynomics DAO"
    mission_statement="Govern the DAO treasury, participation, protocol, and token policy while preserving the retained Redcurry issuance and licensed-distribution boundaries and limiting concentration risk."
    hierarchical_inheritance="false">
    <Role id="HoldingOps" role_name="Holding operations" assignment_method="retained legal authority; confirm mandate" agent_type="human" federation_level="0" aggregation_level="0">
      <associated_to>GA-AR1 PERM-AR1-PROPOSE PERM-AR1-EXECUTE</associated_to>
      <is_controlled_by>InvestmentBoard FoundationOversight</is_controlled_by>
    </Role>
    <Role id="FoundationOversight" role_name="Foundation oversight" assignment_method="existing institutional appointment; verify" agent_type="human" federation_level="0" aggregation_level="0">
      <associated_to>GA-AR1 PERM-AR1-AUDIT</associated_to>
    </Role>
    <Role id="InvestmentExpert" role_name="Investment expert" assignment_method="professional qualification and appointment; verify" agent_type="human" federation_level="0" aggregation_level="0">
      <member_of condition="professional investment-board appointment">InvestmentBoard</member_of>
      <associated_to>GA-AR1 PERM-AR1-PROPOSE</associated_to>
    </Role>
    <Role id="ComplianceOwner" role_name="Compliance owner" assignment_method="authorized legal/compliance appointment; verify" agent_type="human" federation_level="0" aggregation_level="0">
      <associated_to>GA-AR2 PERM-AR2-PROPOSE PERM-AR2-APPROVE PERM-AR2-MONITOR PERM-AR2-ESCALATE</associated_to>
    </Role>
    <Role id="LicensedPartner" role_name="Licensed distribution partner" assignment_method="eligibility and licensing approval" agent_type="human" federation_level="0" aggregation_level="0">
      <associated_to>GA-AR2 PERM-AR2-DISTRIBUTE</associated_to>
      <is_controlled_by>ComplianceOwner</is_controlled_by>
    </Role>
    <Role id="CommunityMember" role_name="Community member" assignment_method="eligibility criteria to be approved" agent_type="human" federation_level="0" aggregation_level="0">
      <member_of condition="approved DAO-token voting eligibility">TokenHolderAssembly</member_of>
      <associated_to>GA-AR3 GA-AR4 GA-AR5 PERM-AR3-PROPOSE PERM-AR4-PROPOSE PERM-AR4-TEMP-CHECK PERM-AR4-APPEAL PERM-AR5-PROPOSE PERM-AR5-DELIBERATE</associated_to>
    </Role>
    <Role id="Moderator" role_name="Forum moderator" assignment_method="community governance appointment; verify" agent_type="human" federation_level="0" aggregation_level="0">
      <associated_to>GA-AR3 PERM-AR3-FILTER</associated_to>
    </Role>
    <Role id="DesignatedSubmitter" role_name="Designated proposal submitter" assignment_method="authorization after filtering; verify" agent_type="human" federation_level="0" aggregation_level="0">
      <associated_to>GA-AR3 PERM-AR3-PROPOSE</associated_to>
      <is_controlled_by>Moderator TokenHolderAssembly</is_controlled_by>
    </Role>
    <Role id="GovernanceAdmin" role_name="Governance administrator" assignment_method="community appointment; verify" agent_type="human" federation_level="0" aggregation_level="0">
      <associated_to>GA-AR4 PERM-AR4-ENACT</associated_to>
      <is_controlled_by>TokenHolderAssembly</is_controlled_by>
    </Role>
    <Role id="TechnicalReviewer" role_name="Technical reviewer" assignment_method="competence-based appointment; verify" agent_type="human" federation_level="0" aggregation_level="0">
      <associated_to>GA-AR5 PERM-AR5-REVIEW</associated_to>
    </Role>
    <Role id="LegalReviewer" role_name="Legal reviewer" assignment_method="legal qualification and appointment; verify" agent_type="human" federation_level="0" aggregation_level="0">
      <associated_to>GA-AR5 PERM-AR5-REVIEW</associated_to>
    </Role>
    <Role id="TechnicalMaintainer" role_name="Technical maintainer" assignment_method="community authorization; verify" agent_type="human" federation_level="0" aggregation_level="0">
      <associated_to>GA-AR5 PERM-AR5-EXECUTE</associated_to>
      <is_controlled_by>TokenHolderAssembly</is_controlled_by>
    </Role>
    <Role id="Auditor" role_name="Independent auditor" assignment_method="independence criteria to be approved" agent_type="human" federation_level="0" aggregation_level="0">
      <associated_to>GA-AR1 GA-AR3 GA-AR4 PERM-AR1-AUDIT PERM-AR3-AUDIT PERM-AR4-AUDIT</associated_to>
    </Role>
    <Role id="ExecutionSigner" role_name="Execution multisig signer" assignment_method="independent signer criteria and threshold pending" agent_type="human" federation_level="0" aggregation_level="0">
      <member_of condition="approved independence and signer-threshold criteria">ExecutionMultisig</member_of>
      <associated_to>GA-AR3 PERM-AR3-EXECUTE</associated_to>
    </Role>
    <Role id="EmergencySigner" role_name="Emergency council signer" assignment_method="scope, expiry, and independence criteria pending" agent_type="human" federation_level="0" aggregation_level="0">
      <member_of condition="approved emergency scope and expiry">EmergencyCouncil</member_of>
      <associated_to>GA-AR1 GA-AR3 GA-AR5 PERM-AR1-EMERGENCY PERM-AR3-VETO PERM-AR3-EMERGENCY PERM-AR5-EMERGENCY</associated_to>
    </Role>
    <Committee id="InvestmentBoard" committee_name="Professional investment board" n_agent_min="3" appointment_method="professional appointment; composition pending" federation_level="1" aggregation_level="0">
      <associated_to>GA-AR1 PERM-AR1-DECIDE</associated_to>
      <is_controlled_by>FoundationOversight</is_controlled_by>
    </Committee>
    <Committee id="TokenHolderAssembly" committee_name="Eligible DAO-token holder assembly" appointment_method="approved eligibility and voting-weight rules" federation_level="1" aggregation_level="0">
      <associated_to>GA-AR3 GA-AR4 GA-AR5 PERM-AR3-VOTE PERM-AR4-VOTE PERM-AR5-VOTE</associated_to>
    </Committee>
    <Committee id="ExecutionMultisig" committee_name="Separate execution multisig" appointment_method="signer threshold and independence rules pending" federation_level="1" aggregation_level="0">
      <associated_to>GA-AR3 PERM-AR3-EXECUTE</associated_to>
      <is_controlled_by>TokenHolderAssembly</is_controlled_by>
    </Committee>
    <Committee id="EmergencyCouncil" committee_name="Emergency council" appointment_method="scope, expiry, and accountability rules pending" federation_level="1" aggregation_level="0">
      <associated_to>GA-AR1 GA-AR3 GA-AR5 PERM-AR1-EMERGENCY PERM-AR3-VETO PERM-AR3-EMERGENCY PERM-AR5-EMERGENCY</associated_to>
    </Committee>
    <GovernanceArea gov_area_ID="GA-AR1" gov_area_description="Redcurry issuance and reserve assets" implementation="hybrid"/>
    <GovernanceArea gov_area_ID="GA-AR2" gov_area_description="Partner eligibility and licensed distribution" implementation="off-chain"/>
    <GovernanceArea gov_area_ID="GA-AR3" gov_area_description="DAO treasury and parameters" implementation="hybrid"/>
    <GovernanceArea gov_area_ID="GA-AR4" gov_area_description="Governance process and community goals" implementation="hybrid"/>
    <GovernanceArea gov_area_ID="GA-AR5" gov_area_description="Protocol upgrades and DAO-token policy" implementation="hybrid"/>
    <Permission permission_ID="PERM-AR1-PROPOSE" allowed_action="propose issuance or reserve action" permission_type="strategic"/>
    <Permission permission_ID="PERM-AR1-DECIDE" allowed_action="decide reserve composition within constraints" permission_type="strategic"/>
    <Permission permission_ID="PERM-AR1-EXECUTE" allowed_action="execute authorized issuance or reserve action" permission_type="operational"/>
    <Permission permission_ID="PERM-AR1-AUDIT" allowed_action="audit issuance and reserve actions" permission_type="operational"/>
    <Permission permission_ID="PERM-AR1-EMERGENCY" allowed_action="invoke approved issuance or reserve emergency action" permission_type="structural"/>
    <Permission permission_ID="PERM-AR2-PROPOSE" allowed_action="propose or review licensed partner" permission_type="operational"/>
    <Permission permission_ID="PERM-AR2-APPROVE" allowed_action="approve partner eligibility" permission_type="strategic"/>
    <Permission permission_ID="PERM-AR2-DISTRIBUTE" allowed_action="distribute Redcurry through licensed channel" permission_type="operational"/>
    <Permission permission_ID="PERM-AR2-MONITOR" allowed_action="monitor partner concentration" permission_type="operational"/>
    <Permission permission_ID="PERM-AR2-ESCALATE" allowed_action="escalate partner concentration breach" permission_type="strategic"/>
    <Permission permission_ID="PERM-AR3-PROPOSE" allowed_action="propose or formally submit treasury or parameter proposal" permission_type="operational"/>
    <Permission permission_ID="PERM-AR3-FILTER" allowed_action="filter proposal before formal submission" permission_type="operational"/>
    <Permission permission_ID="PERM-AR3-VOTE" allowed_action="vote on treasury or parameter proposal" permission_type="strategic"/>
    <Permission permission_ID="PERM-AR3-EXECUTE" allowed_action="execute authorized treasury or parameter proposal" permission_type="operational"/>
    <Permission permission_ID="PERM-AR3-VETO" allowed_action="veto under approved exceptional conditions" permission_type="structural"/>
    <Permission permission_ID="PERM-AR3-AUDIT" allowed_action="audit authorized and executed treasury or parameter actions" permission_type="operational"/>
    <Permission permission_ID="PERM-AR3-EMERGENCY" allowed_action="pause treasury or parameter execution under approved conditions" permission_type="structural"/>
    <Permission permission_ID="PERM-AR4-PROPOSE" allowed_action="propose governance rule or community goal" permission_type="operational"/>
    <Permission permission_ID="PERM-AR4-TEMP-CHECK" allowed_action="conduct off-chain temperature check" permission_type="operational"/>
    <Permission permission_ID="PERM-AR4-VOTE" allowed_action="vote on formal governance rule or goal" permission_type="strategic"/>
    <Permission permission_ID="PERM-AR4-ENACT" allowed_action="enact authorized procedural change" permission_type="operational"/>
    <Permission permission_ID="PERM-AR4-APPEAL" allowed_action="appeal governance-process decision" permission_type="operational"/>
    <Permission permission_ID="PERM-AR4-AUDIT" allowed_action="audit governance-process activity and reasons" permission_type="operational"/>
    <Permission permission_ID="PERM-AR5-PROPOSE" allowed_action="propose protocol upgrade or DAO-token-policy change" permission_type="strategic"/>
    <Permission permission_ID="PERM-AR5-DELIBERATE" allowed_action="deliberate protocol or token-policy proposal" permission_type="operational"/>
    <Permission permission_ID="PERM-AR5-REVIEW" allowed_action="review technical and legal feasibility" permission_type="strategic"/>
    <Permission permission_ID="PERM-AR5-VOTE" allowed_action="authorize protocol or token-policy change" permission_type="structural"/>
    <Permission permission_ID="PERM-AR5-EXECUTE" allowed_action="execute authorized protocol or token-policy change" permission_type="structural"/>
    <Permission permission_ID="PERM-AR5-EMERGENCY" allowed_action="invoke approved emergency protocol action" permission_type="structural"/>
  </DAO>
</DAOMod_DO_diagram>
