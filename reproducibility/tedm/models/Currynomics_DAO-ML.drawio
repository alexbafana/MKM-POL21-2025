  <diagram id="currynomics-dao-ml" name="DAO-ML first draft">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4200" pageHeight="2600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Currynomics DAO-ML — provisional first draft for Sowelu review" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="20" width="2400" height="50" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;Status:&lt;/b&gt; editable review draft, not validated case evidence.&lt;br&gt;Green = Governance Area; actor = Role; hexagon = Committee (provisional glyph); rounded box = Permission set (split into individual Permission nodes as desired).&lt;br&gt;Solid blue = associated_to; dashed red = is_controlled_by; dashed purple = member_of/federation. Exact permission assignments, controller relations, signer thresholds, and emergency scope require confirmation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="120" y="80" width="3720" height="100" as="geometry"/></mxCell>
        <mxCell id="dao" value="&lt;b&gt;DAO-CURRYNOMICS — Currynomics DAO&lt;/b&gt;&lt;br&gt;Mission: accountable and inclusive governance of treasury, process, upgrades, and DAO-token policy while preserving justified Redcurry issuance, reserve, and licensed-distribution boundaries." style="swimlane;html=1;whiteSpace=wrap;startSize=80;horizontal=1;fillColor=#ffffff;swimlaneFillColor=#f5f5f5;strokeColor=#333333;fontSize=16;fontStyle=1;rounded=0;" vertex="1" parent="1"><mxGeometry x="80" y="210" width="3800" height="2220" as="geometry"/></mxCell>

        <mxCell id="GA-AR1" value="&lt;b&gt;GA-AR1&lt;/b&gt;&lt;br&gt;Redcurry issuance and reserve assets&lt;br&gt;&lt;i&gt;hybrid&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="330" width="680" height="90" as="geometry"/></mxCell>
        <mxCell id="GA-AR2" value="&lt;b&gt;GA-AR2&lt;/b&gt;&lt;br&gt;Partner eligibility and licensed distribution&lt;br&gt;&lt;i&gt;off-chain [P]&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="840" y="330" width="680" height="90" as="geometry"/></mxCell>
        <mxCell id="GA-AR3" value="&lt;b&gt;GA-AR3&lt;/b&gt;&lt;br&gt;DAO treasury and parameters&lt;br&gt;&lt;i&gt;hybrid&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1560" y="330" width="680" height="90" as="geometry"/></mxCell>
        <mxCell id="GA-AR4" value="&lt;b&gt;GA-AR4&lt;/b&gt;&lt;br&gt;Governance process and community goals&lt;br&gt;&lt;i&gt;hybrid&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2280" y="330" width="680" height="90" as="geometry"/></mxCell>
        <mxCell id="GA-AR5" value="&lt;b&gt;GA-AR5&lt;/b&gt;&lt;br&gt;Protocol upgrades and DAO-token policy&lt;br&gt;&lt;i&gt;hybrid&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3000" y="330" width="680" height="90" as="geometry"/></mxCell>

        <mxCell id="P-AR1" value="&lt;b&gt;Permissions AR1&lt;/b&gt;&lt;br&gt;PERM-AR1-PROPOSE — propose issuance/reserve action&lt;br&gt;PERM-AR1-DECIDE — decide reserve composition&lt;br&gt;PERM-AR1-EXECUTE — execute authorized action&lt;br&gt;PERM-AR1-AUDIT — audit actions&lt;br&gt;PERM-AR1-EMERGENCY — exceptional action [G]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="120" y="470" width="680" height="190" as="geometry"/></mxCell>
        <mxCell id="P-AR2" value="&lt;b&gt;Permissions AR2&lt;/b&gt;&lt;br&gt;PERM-AR2-PROPOSE — propose/review partner&lt;br&gt;PERM-AR2-APPROVE — approve eligibility [P]&lt;br&gt;PERM-AR2-DISTRIBUTE — licensed distribution&lt;br&gt;PERM-AR2-MONITOR — monitor exposure&lt;br&gt;PERM-AR2-ESCALATE — escalate breach" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="840" y="470" width="680" height="190" as="geometry"/></mxCell>
        <mxCell id="P-AR3" value="&lt;b&gt;Permissions AR3&lt;/b&gt;&lt;br&gt;PERM-AR3-PROPOSE — propose/formalize&lt;br&gt;PERM-AR3-FILTER — filter&lt;br&gt;PERM-AR3-VOTE — vote&lt;br&gt;PERM-AR3-EXECUTE — execute [P/G]&lt;br&gt;PERM-AR3-VETO — veto [G]&lt;br&gt;PERM-AR3-AUDIT — audit [P]&lt;br&gt;PERM-AR3-EMERGENCY — pause [G]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1560" y="470" width="680" height="230" as="geometry"/></mxCell>
        <mxCell id="P-AR4" value="&lt;b&gt;Permissions AR4&lt;/b&gt;&lt;br&gt;PERM-AR4-PROPOSE — propose rule/goal&lt;br&gt;PERM-AR4-TEMP-CHECK — temperature check&lt;br&gt;PERM-AR4-VOTE — formal vote&lt;br&gt;PERM-AR4-ENACT — enact [P]&lt;br&gt;PERM-AR4-APPEAL — appeal [P]&lt;br&gt;PERM-AR4-AUDIT — audit [P]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2280" y="470" width="680" height="215" as="geometry"/></mxCell>
        <mxCell id="P-AR5" value="&lt;b&gt;Permissions AR5&lt;/b&gt;&lt;br&gt;PERM-AR5-PROPOSE — propose change&lt;br&gt;PERM-AR5-DELIBERATE — deliberate&lt;br&gt;PERM-AR5-REVIEW — feasibility review [P]&lt;br&gt;PERM-AR5-VOTE — authorize&lt;br&gt;PERM-AR5-EXECUTE — execute authorized change [P/G]&lt;br&gt;PERM-AR5-EMERGENCY — emergency action [G]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="3000" y="470" width="680" height="215" as="geometry"/></mxCell>

