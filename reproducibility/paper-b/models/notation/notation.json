{
  "name": "Institutional DAO-ML / ET-DM notation",
  "version": "1.0.0",
  "status": "Proposed research notation; not an upstream editor extension or independently evaluated language",
  "node_grammar": [
    "layer badge O/C/E/S",
    "family glyph and family code",
    "exact ontology-class stereotype",
    "stable model element identifier",
    "requirement identifier",
    "concrete value or resolvable worked-instance field pointer"
  ],
  "families": {
    "ASSET": {
      "glyph": "stacked rectangle",
      "meaning": "Identifiable governed semantic resource"
    },
    "STATE": {
      "glyph": "capsule",
      "meaning": "State space; never implicitly an authorization"
    },
    "SCOPE": {
      "glyph": "bracketed square",
      "meaning": "Scope or vocabulary constraining authority"
    },
    "ACTOR": {
      "glyph": "circle",
      "meaning": "Reference to responsibility, body or accountable mandate"
    },
    "PLAN": {
      "glyph": "stacked card",
      "meaning": "Governed action or complete transition plan"
    },
    "POLICY": {
      "glyph": "folded corner",
      "meaning": "Explicit rule or policy reference"
    },
    "GATE": {
      "glyph": "diamond",
      "meaning": "Constraint or confirmation gate; not a decision outcome"
    },
    "RECORD": {
      "glyph": "document",
      "meaning": "Identifiable evidence, authorization or result record"
    },
    "MONITOR": {
      "glyph": "hexagon",
      "meaning": "Observation or escalation specification"
    }
  },
  "layers": {
    "Organization": "O",
    "Coordination": "C",
    "Execution": "E",
    "Safeguard": "S"
  },
  "symbols": [
    {
      "class": "SemanticAsset",
      "ontology_class": "urn:paper-b:institutional-daomod:SemanticAsset",
      "requirement": "OLR1",
      "layer": "Organization",
