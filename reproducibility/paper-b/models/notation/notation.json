  "edges": [
    {
      "kind": "ontology relation",
      "style": "solid directed line",
      "label": "exact ontology property local name",
      "rules": "Source and target must match the declared ontology domain/range."
    },
    {
      "kind": "base-model reference",
      "style": "dashed directed line",
      "label": "baseRef",
      "rules": "Target identifier must resolve in the referenced upstream-compatible model. This is a traceability link, not an OWL object property."
    },
    {
      "kind": "requirement trace",
      "style": "dotted undirected line",
      "label": "requirement identifier",
      "rules": "Identifier must resolve in requirements.csv. This is evidence traceability, not control flow."
    },
    {
      "kind": "illustrative process order",
      "style": "solid directed line in a separate trace view",
      "label": "next [guard]",
      "rules": "Must identify a worked trace; not interpreted as an ontology property or guarantee of execution."
    },
    {
      "kind": "worked field reference",
      "style": "dashed directed line",
      "label": "field:<name>",
      "rules": "A reference encoded in a concrete worked value must resolve to the target identity. This is not an ontology object property unless declared as one."
    }
  ]
}
